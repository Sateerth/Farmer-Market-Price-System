# Twilio SMS credentials — get these from twilio.com/console

SECRET_KEY=your-secret-key-here

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
